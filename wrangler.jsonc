{
  // Accurova BNI gallery hub on Cloudflare Workers (static assets only), deployed by Workers Builds on
  // every push to main. `npm run build` (scripts/build.js) copies the site into dist/ and writes
  // dist/config.js from the build variables SUPABASE_URL and SUPABASE_ANON_KEY (optional LUXSYNC_URL).
  // Set them under Workers & Pages > accurova-bni > Settings > Build > Variables and secrets; the build
  // fails loudly without them. zbpack.json stays for the suspended Zeabur copy (rollback only).
  "name": "accurova-bni",
  "account_id": "c580c4403524273d1bece674117472dd", // accurova account (owns accurova.com)
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  "routes": [{ "pattern": "bni.accurova.com", "custom_domain": true }]
}
